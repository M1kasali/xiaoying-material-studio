# Local demonstration only. Replace these before a shared deployment.
MYSQL_DATABASE=material_studio
MYSQL_USER=studio
MYSQL_PASSWORD=studio_local_password
MYSQL_ROOT_PASSWORD=root_local_password
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307
DEMO_ENABLED=true
SECURE_COOKIE=false
# Update allowed origins if changing exposed ports or using another hostname.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
TASK_WORKERS=2
TASK_QUEUE_CAPACITY=32
SIMULATION_DELAY_MS=2000
